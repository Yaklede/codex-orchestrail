{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "types": ["node"], "noEmit": true
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
